# OpenAI-compatible chat endpoint. Defaults target a local Ollama install, so
# nothing leaves your machine and there are no per-token costs. Point these at
# any OpenAI-compatible provider to use a hosted model instead.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
LLM_API_KEY=ollama
